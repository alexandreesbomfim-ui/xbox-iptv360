name: Build Xbox 360 (libxenon)

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  host-tests:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Testar parser M3U no PC
        run: |
          g++ -std=c++11 -Wall -Wextra -o t tests/test_m3u.cpp source/m3u.cpp
          ./t tests/sample.m3u

  build-xbox360:
    runs-on: ubuntu-latest
    needs: host-tests
    container: free60/libxenon:latest
    env:
      DEVKITXENON: /usr/local/xenon
    steps:
      - uses: actions/checkout@v4
      - name: Compilar para PowerPC (Xenon)
        run: |
          export PATH="$PATH:$DEVKITXENON/bin:$DEVKITXENON/usr/bin"
          make
          file iptv360.elf32
      - name: Montar pacote
        run: |
          mkdir -p dist/iptv360
          cp iptv360.elf32 dist/iptv360/
          cp playlist.m3u dist/iptv360/playlist.m3u
      - uses: actions/upload-artifact@v4
        with:
          name: iptv360-xbox360
          path: dist/
